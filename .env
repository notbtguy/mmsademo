    # ─────────────────────────────────────────────────────────────────
# MSMA Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────
# Used directly by Payload's Postgres adapter.
DATABASE_URI=postgresql://neondb_owner:npg_9aJM8pWSXqGv@ep-quiet-bonus-bectr4vi-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Used by docker-compose.yml to initialize the postgres container.
POSTGRES_DB=msma
POSTGRES_USER=msma
POSTGRES_PASSWORD=msma_local_password

# ── Payload ─────────────────────────────────────────────────────
# Long, random string used to sign auth cookies/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=d6e4b4ac902e3cbb604c4e32ff7292d4956ef79780bc0fcb3b2a73ab06b571d4
# Public URL Payload uses to construct absolute links (emails, media).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── File storage ────────────────────────────────────────────────
# "s3" here = Neon Object Storage (S3-compatible). Two buckets: msma-media
# is public (news/event images, logo), msma-private holds membership
# documents and stays access-controlled via Payload, never public.
STORAGE_DRIVER=s3
STORAGE_LOCAL_ROOT=./storage
# Secret used to sign short-lived private-file download tokens.
PRIVATE_FILE_TOKEN_SECRET=98ca30d7d782c6a29ef19b8539d4d9605556a9cd0853631b4b68ebb396f63281

STORAGE_S3_BUCKET=msma-media
STORAGE_S3_PRIVATE_BUCKET=msma-private
STORAGE_S3_REGION=us-east-2
STORAGE_S3_ENDPOINT=https://br-patient-dust-be7rccvc.storage.c-9.us-east-2.aws.neon.tech
STORAGE_S3_PUBLIC_URL=https://br-patient-dust-be7rccvc.storage.c-9.us-east-2.aws.neon.tech/msma-media
STORAGE_S3_ACCESS_KEY_ID=nak_live_0cf67fe005754b76b5c0778c369b05c0
STORAGE_S3_SECRET_ACCESS_KEY=nsk_live_6f9dfe4103dc72b663c50a19bb4aef43586f02b646fb1ec06173ec912d471c17
STORAGE_S3_FORCE_PATH_STYLE=true

# ── Anti-spam / CAPTCHA (Cloudflare Turnstile) ─────────────────
# Leave blank to disable CAPTCHA enforcement in local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (in-process, single-instance) ────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# ── Outbound email (optional — leave blank to disable email) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── Association identity (non-secret, used by seed script) ─────
ASSOCIATION_SHORT_CODE=MMSA

# ── First Super Admin bootstrap (used only by scripts/seed.ts) ──
# These create the very first admin account. Change the password
# immediately after first login, then you may clear these values.
FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_PASSWORD=change-me-immediately
