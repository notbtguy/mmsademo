# ─────────────────────────────────────────────────────────────────
# MSMA Platform — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────
# Used directly by Payload's Postgres adapter.
# Port 55432 (not the default 5432) avoids clashing with any pre-existing
# native Postgres installation on the host. See docker-compose.yml.
#
# Hosted on a serverless provider (e.g. Neon)? Use the POOLED connection
# string (its host usually has a "-pooler" suffix) — serverless functions
# open a fresh connection per invocation, and only the pooled endpoint
# (PgBouncer) absorbs that without exhausting Postgres' connection limit.
# Neon's connection strings already include ?sslmode=require, which
# node-postgres honors automatically.
DATABASE_URI=postgres://msma:msma_local_password@localhost:55432/msma
# Used by docker-compose.yml to initialize the postgres container.
POSTGRES_DB=msma
POSTGRES_USER=msma
POSTGRES_PASSWORD=msma_local_password

# ── Payload ─────────────────────────────────────────────────────
# Long, random string used to sign auth cookies/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string
# Public URL Payload uses to construct absolute links (emails, media).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── File storage ────────────────────────────────────────────────
# "local" writes to a disk path — fine for Docker Compose (named volume),
# useless on serverless hosts with no writable persistent disk (Vercel).
# "s3" is for exactly that case: an S3-compatible bucket (Cloudflare R2 in
# practice — see src/payload.config.ts for how the two collections below
# are wired to it). Leave as "local" unless deploying to Vercel/similar.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# Secret used to sign short-lived private-file download tokens.
PRIVATE_FILE_TOKEN_SECRET=replace-with-another-long-random-string

# Only used when STORAGE_DRIVER=s3. Works with any S3-compatible provider
# (Cloudflare R2, Neon Object Storage, ...) — one set of credentials/
# endpoint scoped to both buckets below; only the bucket name differs per
# collection. Both known providers require STORAGE_S3_FORCE_PATH_STYLE=true.
#   R2 endpoint:   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Neon endpoint: https://br-<branch>.storage.c-2.<region>.aws.neon.tech
#                  (copy exact value from the Neon console — don't hand-type it)
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
# Public bucket for the "media" collection (news/event images, logo, etc).
# Must have public reads enabled (R2's "Public Development URL"/custom
# domain, or Neon's access:'public_read') — STORAGE_S3_PUBLIC_URL is that
# base URL, used to build direct image links.
STORAGE_S3_BUCKET=
STORAGE_S3_PUBLIC_URL=
# SEPARATE, non-public bucket for "membership-documents" (certificates,
# photographs). Must NOT have public access enabled — reads stay proxied
# through Payload's own access control, same as the local driver.
STORAGE_S3_PRIVATE_BUCKET=

# ── Anti-spam / CAPTCHA (Cloudflare Turnstile) ─────────────────
# Leave blank to disable CAPTCHA enforcement in local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (in-process, single-instance) ────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# ── Outbound email (optional — leave blank to disable email) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── Association identity (non-secret, used by seed script) ─────
ASSOCIATION_SHORT_CODE=ASSOC

# ── First Super Admin bootstrap (used only by scripts/seed.ts) ──
# These create the very first admin account. Change the password
# immediately after first login, then you may clear these values.
FIRST_ADMIN_EMAIL=admin@example.org
FIRST_ADMIN_PASSWORD=change-me-immediately
